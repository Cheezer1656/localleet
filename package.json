{
  "name": "localleet",
  "version": "0.1.0",
  "description": "Browser extension that runs LeetCode testcases locally with WebAssembly toolchains",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "dev": "node scripts/build.mjs chrome firefox --watch",
    "package": "node scripts/build.mjs --zip",
    "test": "npm run test:python && npm run test:cpp && npm run test:content",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v",
    "test:cpp": "node --test tests/cpp.test.mjs",
    "test:content": "node --test tests/harvest.test.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox",
    "test:firefox": "node tests/e2e-firefox.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@yowasp/clang": "^22.0.0-git20542-10",
    "puppeteer-core": "^25.14.0",
    "pyodide": "314.0.7"
  },
  "private": true,
  "license": "MIT"
}
